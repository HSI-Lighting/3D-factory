/target
**/*.rs.bk
.DS_Store

# User-customised ACI picker mapping. The wheel ships with a deterministic
# default layout — this file is only written when the user clicks
# "Save mapping" in the picker. Per-user, not per-codebase.
/aci_mapping.json
target-docker/

# Local build / install logs captured during dev iteration (not source).
*.log

.git_commit_msg.txt

# Editor / OS cruft
*.swp
*~
Thumbs.db
Desktop.ini

# SIMLUX sidecars written next to a drawing during local editing (per-drawing state).
*.simlux.json

# Build output of packaging/build-package.ps1 — a packaged copy of what is already
# in the tree, so committing it would double every asset for no gain.
/dist

# Python test suite artifacts
.venv/
tests/__pycache__/
tests/report/
test-results.xml
